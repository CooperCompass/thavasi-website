# Runtime / compose env (copy to .env on the VPS)

LANDING_URL=https://thavasi.coopercompass.com

# Early-access enquiries are forwarded to Thavasi Scrutiny, which owns them in
# PostgreSQL and shows them in its admin UI. Container name on the shared docker
# network; that app's nginx proxies /api to its FastAPI backend.
SCRUTINY_API_URL=http://thavasi-scrutiny-web/api/v1
