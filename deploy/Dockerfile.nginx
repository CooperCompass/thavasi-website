# syntax=docker/dockerfile:1
# Builds the Vite landing page and serves it with nginx + /api proxy.

FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
ARG VITE_API_URL=same-origin
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/templates/default.conf.template /etc/nginx/templates/default.conf.template
RUN printf '#!/bin/sh\n( while :; do sleep 6h; nginx -s reload 2>/dev/null || true; done ) &\n' \
      > /docker-entrypoint.d/99-reload-loop.sh \
  && chmod +x /docker-entrypoint.d/99-reload-loop.sh
EXPOSE 80 443
